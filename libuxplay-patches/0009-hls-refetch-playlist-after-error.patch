diff --git a/lib/airplay_video.c b/lib/airplay_video.c
index e9db34e..a1840b4 100644
--- a/lib/airplay_video.c
+++ b/lib/airplay_video.c
@@ -835,9 +835,20 @@ int create_media_uri_table(const char *url_prefix, const char *master_playlist_d
  * variants and renditions of one host are kept; airplay_video_skip_source() moves on to
  * the next host after a playback error. */
 static int hls_source_skip = 0;
+static bool hls_refetch_playlist = false;
 
 void airplay_video_skip_source(void) {
     hls_source_skip++;
+    hls_refetch_playlist = true;
+}
+
+/* true (once) after a playback error: a stored playlist must not be played again, as
+ * its media URIs may no longer be valid (they can be bound to the address the client
+ * had when it requested them, and they expire) */
+bool airplay_video_take_refetch(void) {
+    bool refetch = hls_refetch_playlist;
+    hls_refetch_playlist = false;
+    return refetch;
 }
 
 #define MAX_SOURCE_HOSTS 8
