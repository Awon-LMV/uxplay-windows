 /* Adjust uri prefixes in the Master Playlist, for sending to the Media Player */
+/* Redundant sources.  A master playlist may list the same variants on several hosts
+ * (HLS "redundant streams").  The media player does not fall back to another host when
+ * one refuses the request (for example HTTP 403 from a geo-restricted CDN), so only the
+ * variants and renditions of one host are kept; airplay_video_skip_source() moves on to
+ * the next host after a playback error. */
+static int hls_source_skip = 0;
+
+void airplay_video_skip_source(void) {
+    hls_source_skip++;
+}
+
+#define MAX_SOURCE_HOSTS 8
+static bool uri_host(const char *uri, size_t len, const char **host, size_t *host_len) {
+    for (size_t i = 0; i + 3 <= len; i++) {
+        if (!memcmp(uri + i, "://", 3)) {
+            size_t start = i + 3;
+            size_t end = start;
+            while (end < len && uri[end] != '/' && uri[end] != '"' && uri[end] != '\r') {
+                end++;
+            }
+            if (end > start) {
+                *host = uri + start;
+                *host_len = end - start;
+                return true;
+            }
+            return false;
+        }
+    }
+    return false;
+}
+
+/* host of the URI="..." attribute of a tag line, if it has one */
+static bool tag_uri_host(const char *line, size_t len, const char **host, size_t *host_len) {
+    const char *attr = "URI=\"";
+    size_t attr_len = strlen(attr);
+    for (size_t i = 0; i + attr_len <= len; i++) {
+        if (!memcmp(line + i, attr, attr_len)) {
+            return uri_host(line + i + attr_len, len - i - attr_len, host, host_len);
+        }
+    }
+    return false;
+}
+
+static char *select_master_playlist_source(char *master_playlist) {
+    const char *stream_inf = "#EXT-X-STREAM-INF:";
+    size_t stream_inf_len = strlen(stream_inf);
+    const char *hosts[MAX_SOURCE_HOSTS];
+    size_t host_lens[MAX_SOURCE_HOSTS];
+    int nhosts = 0;
+    bool after_stream_inf = false;
+
+    /* collect the hosts of the variant URIs, in order of first appearance */
+    for (char *line = master_playlist; line && *line; ) {
+        char *eol = strchr(line, '\n');
+        size_t len = eol ? (size_t) (eol - line) : strlen(line);
+        if (!strncmp(line, stream_inf, stream_inf_len)) {
+            after_stream_inf = true;
+        } else if (after_stream_inf && len > 0 && line[0] != '#' && line[0] != '\r') {
+            const char *host = NULL;
+            size_t host_len = 0;
+            after_stream_inf = false;
+            if (uri_host(line, len, &host, &host_len)) {
+                bool known = false;
+                for (int i = 0; i < nhosts; i++) {
+                    if (host_lens[i] == host_len && !memcmp(hosts[i], host, host_len)) {
+                        known = true;
+                        break;
+                    }
+                }
+                if (!known && nhosts < MAX_SOURCE_HOSTS) {
+                    hosts[nhosts] = host;
+                    host_lens[nhosts] = host_len;
+                    nhosts++;
+                }
+            }
+        }
+        line = eol ? eol + 1 : NULL;
+    }
+    if (nhosts < 2) {
+        return master_playlist;
+    }
+
+    /* copy of the chosen host: the playlist is edited in place below */
+    int chosen = hls_source_skip % nhosts;
+    char chosen_host[256];
+    size_t chosen_len = host_lens[chosen];
+    if (chosen_len >= sizeof(chosen_host)) {
+        return master_playlist;
+    }
+    memcpy(chosen_host, hosts[chosen], chosen_len);
+    chosen_host[chosen_len] = '\0';
+
+    char *out = master_playlist;
+    char *pending = NULL;        /* a #EXT-X-STREAM-INF line waiting for its URI line */
+    size_t pending_len = 0;
+    for (char *line = master_playlist; line && *line; ) {
+        char *eol = strchr(line, '\n');
+        size_t len = eol ? (size_t) (eol - line) : strlen(line);
+        size_t full_len = eol ? len + 1 : len;
+        char *next = eol ? eol + 1 : NULL;
+        const char *host = NULL;
+        size_t host_len = 0;
+        bool keep = true;
+        if (!strncmp(line, stream_inf, stream_inf_len)) {
+            /* decided when its URI line is seen */
+            pending = line;
+            pending_len = full_len;
+            line = next;
+            continue;
+        } else if (pending && len > 0 && line[0] != '#' && line[0] != '\r') {
+            keep = !uri_host(line, len, &host, &host_len) ||
+                   (host_len == chosen_len && !memcmp(host, chosen_host, chosen_len));
+            if (keep) {
+                memmove(out, pending, pending_len);
+                out += pending_len;
+            }
+            pending = NULL;
+        } else if (line[0] == '#' && tag_uri_host(line, len, &host, &host_len)) {
+            keep = (host_len == chosen_len && !memcmp(host, chosen_host, chosen_len));
+        }
+        if (keep) {
+            memmove(out, line, full_len);
+            out += full_len;
+        }
+        line = next;
+    }
+    *out = '\0';
+    return master_playlist;
+}
