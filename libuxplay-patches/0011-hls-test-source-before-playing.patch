+static void failed_host_add(const char *host, size_t len) {
+    if (len == 0 || len >= SOURCE_HOST_LEN || failed_host_index(host, len) >= 0) {
+        return;
+    }
+    if (num_failed_hosts == MAX_FAILED_HOSTS) {
