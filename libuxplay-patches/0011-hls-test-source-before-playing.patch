+/* true if the server answers a request for this uri with data (tested with the same
+ * HTTP source element that the HLS player uses) */
+bool video_renderer_probe_uri(const char *uri) {
+    bool ok = false;
+    GstElement *pipeline = gst_pipeline_new("uri-probe");
+    GstElement *src = gst_element_factory_make("souphttpsrc", NULL);
+    GstElement *sink = gst_element_factory_make("fakesink", NULL);
+    if (!pipeline || !src || !sink) {
+        /* the test cannot be made: assume that the uri can be used */
+        if (pipeline) gst_object_unref(pipeline);
+        if (src) gst_object_unref(src);
+        if (sink) gst_object_unref(sink);
+        return true;
+    }
+    g_object_set(G_OBJECT(src), "location", uri, "timeout", (guint) 5, "retries", (gint) 0, NULL);
+    gst_bin_add_many(GST_BIN(pipeline), src, sink, NULL);
+    if (gst_element_link(src, sink)) {
+        GstBus *bus = gst_element_get_bus(pipeline);
+        gst_element_set_state(pipeline, GST_STATE_PAUSED);
+        GstMessage *msg = gst_bus_timed_pop_filtered(bus, 6 * GST_SECOND,
+                                                     (GstMessageType) (GST_MESSAGE_ERROR | GST_MESSAGE_ASYNC_DONE));
+        ok = (msg && GST_MESSAGE_TYPE(msg) == GST_MESSAGE_ASYNC_DONE);
+        if (msg) {
+            gst_message_unref(msg);
+        }
+        gst_object_unref(bus);
+    }
+    gst_element_set_state(pipeline, GST_STATE_NULL);
+    gst_object_unref(pipeline);
+    logger_log(logger, LOGGER_INFO, "HLS source test: %s %s", ok ? "ok    " : "FAILED", uri);
+    return ok;
+}
