+
+/* optional test that a media URI can be fetched, supplied by the application */
+static bool (*uri_probe)(const char *uri) = NULL;
+
+void airplay_video_set_uri_probe(bool (*probe)(const char *uri)) {
+    uri_probe = probe;
+}
+
+/* true if the media player can be expected to fetch this media playlist.  A server
+ * that refuses the request must not be handed to the media player: it would keep
+ * repeating the request, and cannot be stopped while it does. */
+static bool source_usable(const char *uri, size_t uri_len, const char *host, size_t host_len) {
+    const char *local1 = "localhost";
+    const char *local2 = "127.0.0.1";
+    bool usable;
+    char *copy;
+    if (!uri_probe) {
+        return true;
+    }
+    /* URIs served by this application (YouTube playlists) are not tested */
+    if (host_len >= strlen(local1) && !memcmp(host, local1, strlen(local1))) {
+        return true;
+    }
+    if (host_len >= strlen(local2) && !memcmp(host, local2, strlen(local2))) {
+        return true;
+    }
+    while (uri_len > 0 && (uri[uri_len - 1] == '\r' || uri[uri_len - 1] == ' ')) {
+        uri_len--;
+    }
+    copy = (char *) malloc(uri_len + 1);
+    if (!copy) {
+        return true;
+    }
+    memcpy(copy, uri, uri_len);
+    copy[uri_len] = '\0';
+    usable = uri_probe(copy);
+    free(copy);
+    return usable;
+}
