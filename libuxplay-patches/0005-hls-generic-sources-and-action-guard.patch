 /* Adjust uri prefixes in the Master Playlist, for sending to the Media Player */
+/* Helpers for master playlists of sources other than YouTube: make relative URIs
+ * absolute, using the location the playlist was fetched from, so that the media
+ * player can fetch the media playlists and segments directly from the source. */
+static char *append_absolute_uri(char *out, const char *uri, size_t len,
+                                 const char *base, size_t base_len, size_t origin_len) {
+    bool absolute = false;
+    for (size_t i = 0; i + 3 <= len; i++) {
+        if (!memcmp(uri + i, "://", 3)) {
+            absolute = true;
+            break;
+        }
+    }
+    if (!absolute && len > 0) {
+        if (uri[0] == '/') {
+            /* path-absolute URI: prepend scheme://host */
+            memcpy(out, base, origin_len);
+            out += origin_len;
+        } else {
+            memcpy(out, base, base_len);
+            out += base_len;
+            *out++ = '/';
+        }
+    }
+    memcpy(out, uri, len);
+    return out + len;
+}
+
+static char *absolutize_master_playlist(const char *data, size_t datalen, const char *base) {
+    const char *attr = "URI=\"";
+    size_t attr_len = strlen(attr);
+    size_t base_len = strlen(base);
+    size_t origin_len = base_len;
+    const char *scheme_end = strstr(base, "://");
+    if (scheme_end) {
+        const char *path = strchr(scheme_end + 3, '/');
+        if (path) {
+            origin_len = (size_t) (path - base);
+        }
+    }
+    /* upper bound on the number of URIs: one per line plus one per URI="..." attribute */
+    size_t uri_count = 1;
+    for (size_t i = 0; i < datalen; i++) {
+        if (data[i] == '\n') {
+            uri_count++;
+        }
+    }
+    for (const char *p = strstr(data, attr); p; p = strstr(p + attr_len, attr)) {
+        uri_count++;
+    }
+    char *out = (char *) malloc(datalen + uri_count * (base_len + 1) + 1);
+    if (!out) {
+        printf("Memory allocation failure (absolutize_master_playlist)\n");
+        exit(1);
+    }
+    char *o = out;
+    const char *line = data;
+    const char *end = data + datalen;
+    while (line < end) {
+        const char *eol = (const char *) memchr(line, '\n', (size_t) (end - line));
+        size_t len = eol ? (size_t) (eol - line) : (size_t) (end - line);
+        if (len > 0 && line[0] != '#' && line[0] != '\r') {
+            /* a URI line */
+            o = append_absolute_uri(o, line, len, base, base_len, origin_len);
+        } else {
+            /* a tag (or empty) line: only URI="..." attributes are rewritten */
+            size_t pos = 0;
+            while (pos < len) {
+                if (len - pos >= attr_len && !memcmp(line + pos, attr, attr_len)) {
+                    memcpy(o, attr, attr_len);
+                    o += attr_len;
+                    pos += attr_len;
+                    size_t uri_len = 0;
+                    while (pos + uri_len < len && line[pos + uri_len] != '"') {
+                        uri_len++;
+                    }
+                    o = append_absolute_uri(o, line + pos, uri_len, base, base_len, origin_len);
+                    pos += uri_len;
+                } else {
+                    *o++ = line[pos++];
+                }
+            }
+        }
+        if (eol) {
+            *o++ = '\n';
+            line = eol + 1;
+        } else {
+            line = end;
+        }
+    }
+    *o = '\0';
+    return out;
+}
