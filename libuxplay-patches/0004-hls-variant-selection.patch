+/* HLS variant selection.  hlsdemux chooses the variant from the download rate it measures,
+ * but for short fragments that rate is dominated by per-request latency (redirects, TLS
+ * setup): the lower the quality, the smaller the fragments and the lower the measured
+ * rate, so playback drifts down to the lowest quality.  A lower bound on the variant
+ * bitrate stops that drift while still letting hlsdemux adapt above it.
+ *   UXPLAY_HLS_MIN_BITRATE=<bit/s>        lower bound (default 1200000; 0 = none)
+ *   UXPLAY_HLS_CONNECTION_SPEED=<kbit/s>  use a fixed rate instead of measuring (default: measure) */
+static void hls_element_setup(GstElement *playbin, GstElement *element, gpointer user_data) {
+    GstElementFactory *factory = gst_element_get_factory(element);
+    const gchar *name = factory ? GST_OBJECT_NAME(factory) : NULL;
+    if (!name || !g_str_has_prefix(name, "hlsdemux")) {
+        return;
+    }
+    guint64 min_bitrate = 1200000;
+    const gchar *min_env = g_getenv("UXPLAY_HLS_MIN_BITRATE");
+    if (min_env) {
+        min_bitrate = g_ascii_strtoull(min_env, NULL, 10);
+    }
+    if (min_bitrate > 0 && min_bitrate <= G_MAXUINT &&
+        g_object_class_find_property(G_OBJECT_GET_CLASS(element), "min-bitrate")) {
+        g_object_set(element, "min-bitrate", (guint) min_bitrate, NULL);
+        logger_log(logger, LOGGER_INFO, "HLS minimum variant bitrate set to %u bit/s", (guint) min_bitrate);
+    }
+}
